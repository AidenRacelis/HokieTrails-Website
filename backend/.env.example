# Copy to .env and adjust for your environment.

# Secret used to sign JWT access tokens. CHANGE THIS in production.
SECRET_KEY=dev-secret-change-me

# Which service this process should mount: auth | trails | housing | all
SERVICE=all

# Directory that holds the JSON databases (trails.json, housing.json, users.json)
DATA_DIR=./data

# Comma-separated list of allowed browser origins (use * for local dev)
CORS_ORIGINS=http://localhost:3000

# JWT access-token lifetime in minutes (default: one week)
JWT_EXPIRES_MINUTES=10080

# Port the dev server / gunicorn binds to
PORT=5000
